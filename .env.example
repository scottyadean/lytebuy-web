# Blog service. Point at `sls offline` locally, or the deployed API Gateway URL.
BLOG_API_URL=http://localhost:5600/local

# API Gateway usage-plan key. Reads (list, single item, view bumps) are all
# public now, so this is optional; it is still sent when present, harmlessly, in
# case a stage ever re-guards a read route. Not needed locally under --noAuth.
BLOG_API_KEY=

# Absolute origin used for canonical URLs, OG tags and the sitemap.
PUBLIC_SITE_URL=http://localhost:5173

# Google Analytics measurement ID. Leave empty to load no analytics at all.
PUBLIC_GA_ID=

# lytebuy backend (FastAPI). Used server-side for the live vendor count.
LYTEBUY_API_URL=http://localhost:8000/api/v1
